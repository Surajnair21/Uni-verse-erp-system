generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  HOD
  FACULTY
  STUDENT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String
  role         Role   @default(STUDENT)

  // Optional scope for HOD/FACULTY
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  studentProfile StudentProfile?
  facultyProfile FacultyProfile?

  enrollments        Enrollment[]               @relation("studentEnrollments")
  facultyAllocations FacultySubjectAllocation[] @relation("facultyAllocations")
  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]
  timetableSlots     TimetableSlot[]
  facultyIAComponents IAComponent[]             @relation("facultyIAComponents")
  studentIAMarks      IAMark[]                  @relation("studentIAMarks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  users    User[]
  programs Program[]
  subjects Subject[]
  sections Section[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Program {
  id   String @id @default(cuid())
  name String
  code String @unique

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

model Course {
  id   String @id @default(cuid())
  name String
  code String @unique

  programId String
  program   Program @relation(fields: [programId], references: [id])

  semesters Semester[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
}

model Semester {
  id     String @id @default(cuid())
  number Int

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  sections Section[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, number])
  @@index([courseId])
}

model Section {
  id        String @id @default(cuid())
  name      String // e.g., A, B
  batchYear Int // e.g., 2025

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])

  enrollments        Enrollment[]
  allocations        FacultySubjectAllocation[]
  studentProfiles    StudentProfile[]
  attendanceSessions AttendanceSession[]
  timetableSlots     TimetableSlot[]
  iaComponents       IAComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([semesterId, name, batchYear])
  @@index([departmentId])
  @@index([semesterId])
}

model Subject {
  id      String @id @default(cuid())
  name    String
  code    String @unique
  credits Int

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  allocations        FacultySubjectAllocation[]
  attendanceSessions AttendanceSession[]
  timetableSlots     TimetableSlot[]
  iaComponents       IAComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

model FacultyProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id])
  employeeId String? @unique
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])

  rollNo    String? @unique
  batchYear Int?
}

model Enrollment {
  id        String @id @default(cuid())
  studentId String
  student   User   @relation(fields: [studentId], references: [id], name: "studentEnrollments")

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([studentId, sectionId])
  @@index([sectionId])
}

model FacultySubjectAllocation {
  id String @id @default(cuid())

  facultyId String
  faculty   User   @relation(fields: [facultyId], references: [id], name: "facultyAllocations")

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([facultyId, subjectId, sectionId])
  @@index([subjectId])
  @@index([sectionId])
}

model TimetableSlot {
  id        String   @id @default(cuid())
  dayOfWeek DayOfWeek
  startTime String   // e.g., "09:00"
  endTime   String   // e.g., "10:00"
  room      String?

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  facultyId String
  faculty   User    @relation(fields: [facultyId], references: [id])

  attendanceSessions AttendanceSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@index([facultyId])
  @@index([dayOfWeek])
}

model AttendanceSession {
  id        String   @id @default(cuid())
  date      DateTime // store date at 00:00 (normalized)
  sectionId String
  subjectId String
  facultyId String

  timetableSlotId String?
  timetableSlot TimetableSlot? @relation(fields: [timetableSlotId], references: [id])

  createdAt DateTime @default(now())

  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  faculty User    @relation(fields: [facultyId], references: [id])

  records AttendanceRecord[]

  @@unique([date, timetableSlotId]) // prevents duplicate session same day for same slot
  @@index([sectionId, subjectId])
  @@index([facultyId, date])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  markedAt  DateTime         @default(now())

  session AttendanceSession @relation(fields: [sessionId], references: [id])
  student User              @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId]) // one mark per student per session
  @@index([studentId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// ─────────────────────────────────────────────
//  Internal Assessment (IA) Models
// ─────────────────────────────────────────────

enum IAComponentType {
  QUIZ
  ASSIGNMENT
  MIDTERM
  PROJECT
  PRACTICAL
}

model IAComponent {
  id          String          @id @default(cuid())
  name        String          // e.g. "Quiz 1", "Mid-Term"
  type        IAComponentType
  maxMarks    Float           // e.g. 20.0
  weightage   Float?          // optional percentage weight, e.g. 10.0

  subjectId   String
  subject     Subject         @relation(fields: [subjectId], references: [id])

  sectionId   String
  section     Section         @relation(fields: [sectionId], references: [id])

  facultyId   String
  faculty     User            @relation("facultyIAComponents", fields: [facultyId], references: [id])

  marks       IAMark[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([subjectId, sectionId, name])
  @@index([sectionId])
  @@index([facultyId])
}

model IAMark {
  id          String       @id @default(cuid())

  componentId String
  component   IAComponent  @relation(fields: [componentId], references: [id], onDelete: Cascade)

  studentId   String
  student     User         @relation("studentIAMarks", fields: [studentId], references: [id])

  marksObtained Float      // e.g. 17.5

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([componentId, studentId])
  @@index([studentId])
}

