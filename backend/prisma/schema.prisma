generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  HOD
  FACULTY
  STUDENT
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String
  role         Role   @default(STUDENT)

  // Optional scope for HOD/FACULTY
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  studentProfile StudentProfile?
  facultyProfile FacultyProfile?

  enrollments        Enrollment[]               @relation("studentEnrollments")
  facultyAllocations FacultySubjectAllocation[] @relation("facultyAllocations")
  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  users    User[]
  programs Program[]
  subjects Subject[]
  sections Section[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Program {
  id   String @id @default(cuid())
  name String
  code String @unique

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

model Course {
  id   String @id @default(cuid())
  name String
  code String @unique

  programId String
  program   Program @relation(fields: [programId], references: [id])

  semesters Semester[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
}

model Semester {
  id     String @id @default(cuid())
  number Int

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  sections Section[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, number])
  @@index([courseId])
}

model Section {
  id        String @id @default(cuid())
  name      String // e.g., A, B
  batchYear Int // e.g., 2025

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])

  enrollments        Enrollment[]
  allocations        FacultySubjectAllocation[]
  studentProfiles    StudentProfile[]
  attendanceSessions AttendanceSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([semesterId, name, batchYear])
  @@index([departmentId])
  @@index([semesterId])
}

model Subject {
  id      String @id @default(cuid())
  name    String
  code    String @unique
  credits Int

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  allocations        FacultySubjectAllocation[]
  attendanceSessions AttendanceSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

model FacultyProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id])
  employeeId String? @unique
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])

  rollNo    String? @unique
  batchYear Int?
}

model Enrollment {
  id        String @id @default(cuid())
  studentId String
  student   User   @relation(fields: [studentId], references: [id], name: "studentEnrollments")

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([studentId, sectionId])
  @@index([sectionId])
}

model FacultySubjectAllocation {
  id String @id @default(cuid())

  facultyId String
  faculty   User   @relation(fields: [facultyId], references: [id], name: "facultyAllocations")

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([facultyId, subjectId, sectionId])
  @@index([subjectId])
  @@index([sectionId])
}

model AttendanceSession {
  id        String   @id @default(cuid())
  date      DateTime // store date at 00:00 (normalized)
  sectionId String
  subjectId String
  facultyId String
  createdAt DateTime @default(now())

  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  faculty User    @relation(fields: [facultyId], references: [id])

  records AttendanceRecord[]

  @@unique([date, sectionId, subjectId]) // prevents duplicate session same day
  @@index([sectionId, subjectId])
  @@index([facultyId, date])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  markedAt  DateTime         @default(now())

  session AttendanceSession @relation(fields: [sessionId], references: [id])
  student User              @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId]) // one mark per student per session
  @@index([studentId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}
